.TH SoX 3 "August 11, 2024" "libsox_ng" "Sound eXchange_ng"
.SH NAME
libsox_ng, another audio file format and effect library
.SH SYNOPSIS
.B #include <sox_ng.h>
.P
.B cc \-o \fIfile file.c\fB \-lsox_ng
.na
.nh
.P
